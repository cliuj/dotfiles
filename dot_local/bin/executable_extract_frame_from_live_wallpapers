#!/bin/bash

set -e

output_dir="${1:-$HOME/.cache/extracted_frames}"
echo "Creating output dir if doesn't exist"
mkdir -p "${output_dir}"

# Extract a frame from a video into an image file (for converting video to image
# since matugen doesn't work on video).
for file in ~/Pictures/live\ wallpapers/*.mp4; do
    [ -e "${file}" ] || continue
    echo "Processing ${file}"

    name="${file##*/}"
    name="${name%.*}"

    output_path="${output_dir}/${name}.png"

    [ -f "${output_path}" ] && echo "Skipping ${file} because file already exists" && continue

    ffmpeg -ss 2 -hide_banner -loglevel error -i "${file}" -frames:v 1 "${output_path}"

    printf '\e[32m✓\e[0m Created file: %s\n' "${output_path}"
done
